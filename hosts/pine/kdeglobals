# Adwaita Dark KDE color scheme.
#
# Consumed by the KDE runtime's "kde" platform theme (plasma-integration) that
# Qt flatpaks use via QT_QPA_PLATFORMTHEME=kde (see the flatpak override in
# home.nix). Symlinked to ~/.config/kdeglobals, which the flatpak sandbox
# bind-mounts read-only onto $XDG_CONFIG_HOME/kdeglobals, so every KDE-runtime
# Qt flatpak reads these colors.
#
# Why this file exists at all: on COSMIC there is no native Qt platform-theme
# plugin that produces the Adwaita palette for the current KDE runtime
# (QGnomePlatform, the plugin that does this and auto-installs on GNOME, is not
# built for org.kde.Platform 5.15-25.08). The Adwaita-Dark *style* only draws
# widget shapes, not colors. So we hand the palette to plasma-integration as a
# color scheme. Values are the official libadwaita dark named-colors
# (window_bg #242424, view_bg #1e1e1e, headerbar #303030, accent #3584e4, ...).
[General]
ColorScheme=AdwaitaDark
Name=Adwaita Dark
shadeSortColumn=true

[KDE]
contrast=4

[Icons]
Theme=Adwaita

